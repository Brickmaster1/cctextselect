{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_name}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "${archives_name}.${mod_id}.fabric.CCTextSelectFabric"
    ],
    "client": [
      "${archives_name}.${mod_id}.fabric.client.CCTextSelectFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*"
  }
}
